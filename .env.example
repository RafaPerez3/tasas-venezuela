# Copia este archivo como ".env" (ese sí está ignorado por git) y pon tus datos reales.
# En Render: Settings -> Environment -> Add Environment Variable (las dos de abajo).

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Base de datos del historial (Upstash Redis -> pestaña "REST API" de la base de datos).
# Sin estas dos el servidor funciona igual, pero la pestaña Historial no tiene datos.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
